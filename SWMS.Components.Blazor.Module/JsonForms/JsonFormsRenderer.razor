<JsonFormsView JsonSchema="@ComponentModel.JsonSchema"
               UiSchema="@ComponentModel.UiSchema"
               JsonData="@ComponentModel.Value"
               OnJsonDataChanged="@ComponentModel.OnJsonDataChanged" />


@code {

    public static RenderFragment Create(JsonFormsViewModel componentModel) =>
    @<JsonFormsRenderer ComponentModel=@componentModel />;

    [Parameter]
    public JsonFormsViewModel ComponentModel { get; set; }
}
