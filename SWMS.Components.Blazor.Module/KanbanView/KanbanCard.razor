@using Microsoft.AspNetCore.Components.Web
@using SWMS.Components.Blazor.Module.KanbanView.Models

@inject DevExpress.ExpressApp.Blazor.Services.IXafApplicationProvider XafApplicationProvider

<style>
    .kanban-card {
        background-color: white;
        border: 1px solid lightgray;
        border-radius: 6px;
        padding: 8px;
        margin-bottom: 8px;
        cursor: grab;
    }
    .kanban-card:hover {
      box-shadow: 0 4px 8px 0 rgba(0,0,0,0.2);
    }

    .kanban-card:active {
        cursor: grabbing;
        opacity: 0.6;
    }
    
    .kanban-card-title {
        font-weight: bold;
    }
    
    .kanban-drop-target {
        outline: 2px dashed #3b82f6;
        outline-offset: -4px;
        background-color: rgba(59,130,246,0.05);
    }

    .kanban-card.disabled {
        cursor: default;
    }
    
</style>

<div class="kanban-card @(Item.IsDragEnabled ? "" : "disabled")"
     draggable="@(Item.IsDragEnabled ? "true" : "false")"
     @ondragstart="OnDragStart"
     @ondragend="OnDragEnd"
     @ondblclick="() => OpenDetailView(Item)">

    <div class="kanban-card-title">
        @Item.KanbanTitle
    </div>

    @if (!string.IsNullOrEmpty(Item.KanbanDescription))
    {
        <div class="kanban-card-description">
            @Item.KanbanDescription
        </div>
    }
</div>

@code {
    [Parameter] public IKanbanItem Item { get; set; }

    private void OnDragStart(DragEventArgs e)
    {
        if (!Item.IsDragEnabled)
        {
            return;
        }

        KanbanDragContext.CurrentItem = Item;

        // REQUIRED for Firefox & consistency
        e.DataTransfer.DropEffect = "move";
        e.DataTransfer.EffectAllowed = "move";
    }
    
    private void OnDragEnd(DragEventArgs e)
    {
        KanbanDragContext.CurrentItem = null;
    }

    private void OpenDetailView(IKanbanItem item)
    {
        if (item is not DevExpress.Persistent.BaseImpl.EF.BaseObject bo)
            return;

        var app = XafApplicationProvider.GetApplication();
        var objectSpace = app.CreateObjectSpace(bo.GetType());
        var selectedObject = objectSpace.GetObject(bo);

        var detailView = app.CreateDetailView(
            objectSpace: objectSpace,
            obj: selectedObject,
            isRoot: true
        );

        app.ShowViewStrategy.ShowViewFromCommonView(detailView);
    }
}
