@using DevExpress.ExpressApp
@using Microsoft.AspNetCore.Components.Web
@using SWMS.Components.Blazor.Module.KanbanView.Models

@inject DevExpress.ExpressApp.Blazor.Services.IXafApplicationProvider XafApplicationProvider

<style>
    .kanban-column {
        flex: 0 0 auto; 
        min-width: 280px;
        max-width: 360px;
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    /* Fixed header */
    .kanban-column-header {
        flex: 0 0 auto;
        padding: 8px;
        font-size: medium;
    }

    /* Scrollable area */
    .kanban-column-body {
        flex: 1 1 auto;
        overflow-y: auto;
        padding: 8px;
        background: var(--bs-gray-200);
        border-radius: 6px;
    }
</style>

<div class="kanban-column @DropCss"
     @ondragover="OnDragOver"
     @ondragover:preventDefault
     @ondragleave="OnDragLeave"
     @ondrop="OnDrop">

    <div class="kanban-column-header">
        @Column.KanbanColumnName
    </div>

    <div class="kanban-column-body">
        @foreach (var item in Items)
        {
            <KanbanCard Item="item" />
        }
    </div>
</div>

@code {
    [Parameter] public IKanbanColumn Column { get; set; }
    [Parameter] public List<IKanbanItem> Items { get; set; }

    [Parameter] public EventCallback<(IKanbanItem, IKanbanColumn)> OnItemDropped { get; set; }

    private bool isDragOver;

    private void OnDragOver(DragEventArgs e)
    {
        isDragOver = true;
    }

    private void OnDragLeave(DragEventArgs e)
    {
        isDragOver = false;
    }

    private async Task OnDrop(DragEventArgs e)
    {
        isDragOver = false;
        var item = KanbanDragContext.CurrentItem;
        if (item != null)
        {
            if (item.CanDropTo(Column))
            {
                await OnItemDropped.InvokeAsync((item, Column));
            }
            else 
            {
                var app = XafApplicationProvider.GetApplication();

                app?.ShowViewStrategy.ShowMessage(
                    $"Cannot move item '{item.KanbanTitle}' to '{Column.KanbanColumnName}'.",
                    InformationType.Warning,
                    3000
                );
            }
        }
    }

    private string DropCss => isDragOver ? "kanban-drop-target" : "";
}
