@using DevExpress.Blazor
@using SWMS.Components.Blazor.Module.KanbanView.Models
@using System.Collections.Generic

<style>
    .kanban-board {
        display: flex;
        gap: 12px;
        height: 100%;
        overflow-x: auto;
        padding: 8px;
    }
</style>

@if (Items != null && Columns != null)
{

    <div class="kanban-board">
        @foreach (var column in Columns.OrderBy(c => c.KanbanColumnIndex))
        {
            <KanbanColumn Column="column"
            Items="Items.Where(i => i.KanbanColumn == column).ToList()"
            OnItemDropped="OnItemDropped" />
        }
    </div>
}
@code {
    [Parameter] public IEnumerable<IKanbanItem> Items { get; set; }
    [Parameter] public IEnumerable<IKanbanColumn> Columns { get; set; }

    [Parameter] public EventCallback<(IKanbanItem item, IKanbanColumn target)> ItemMoved { get; set; }

    private async Task OnItemDropped((IKanbanItem item, IKanbanColumn target) args)
    {
        args.item.KanbanColumn = args.target;
        await ItemMoved.InvokeAsync(args);
        StateHasChanged();
    }
}
